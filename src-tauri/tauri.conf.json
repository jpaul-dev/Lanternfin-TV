{
  "productName": "Lanternfin TV",
  "mainBinaryName": "lanternfin-tv",
  "version": "0.1.0-alpha.1",
  "identifier": "io.github.jpauldev.lanternfin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run dev",
    "beforeBuildCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Lanternfin TV",
        "width": 1300,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "jpaul-dev",
    "category": "public.app-category.video",
    "copyright": "Copyright (c) 2025 Ludovico Ferrara; modifications (c) 2026 Lanternfin TV contributors",
    "createUpdaterArtifacts": false,
    "android": {
      "versionCode": 1
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
